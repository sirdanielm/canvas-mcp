# Paths that scripts/deploy_site.sh leaves out of the site (rsync exclude patterns).
# `wrangler pages deploy` reads neither this file nor .gitignore: deploy with
# scripts/deploy_site.sh, never with a bare `wrangler pages deploy docs/`.
# Keep in step with the docs/ entries in the repo .gitignore.

# Hosted-deployment ops notes (endpoint URL, Entra IDs, key-holders)
*.local.md

# Internal compliance email drafts
compliance/

# Session triage logs (working notes, not site content)
triage/

# Prompt/code audit reports (internal working documents, not site content)
audits/

# Local GrAss transfer history and detailed operator checkpoints.
# Match private review directories at any depth; the deployment checker accepts
# directory-name patterns without embedded path separators.
GRASS_TOOLBOX_CHECKPOINT_*.md
grass-next-*/

# Public-safe repository audit records are not website assets.
overhaul/

# Agent plans and specs (working documents in the repository, not site content)
superpowers/
